{
  "version": "ssl-v1",
  "model": "cnn",
  "seeds": [570, 571, 572],
  "label_percents": [10, 25, 100],
  "classifier": {
    "cpu_threads": 2,
    "epochs": 30,
    "patience": 6,
    "batch_size": 128,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "dropout": 0.2,
    "conv_channels": [32, 64],
    "gradient_clip_norm": 5.0
  },
  "pretraining": {
    "epochs": 15,
    "span_length": 16
  },
  "selection_metric": "validation_macro_f1",
  "tie_break": "earliest_epoch",
  "test_scoring": false
}
